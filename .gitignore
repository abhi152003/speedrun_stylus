# Environment variable files
.env
.env.*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# NPM auth tokens
.npmrc

# Private key material
*.pem
*.key
*.csr
*.crt
*.p12
*.jks

# SSH keys
id_rsa
id_rsa.pub
id_dsa
id_dsa.pub
id_ecdsa
id_ecdsa.pub
id_ed25519
id_ed25519.pub
ssh_config

# AWS credentials
.aws/credentials
.aws/config

# GPG keys and signature files
*.gpg
*.asc

# Kubernetes config
.kube/config
*.kube/config

# Google Cloud service account keys
*.json                    # e.g. service-account.json

# Azure publish settings
*.publishsettings

# Heroku API key
.heroku

# Terraform sensitive files
terraform.tfstate
terraform.tfstate.*
*.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Vault and Ansible secrets
vault-*.yml
group_vars/*  # if you store sensitive data here
host_vars/*

# CI/CD sensitive env files
.travis.env
.circleci/*.env
github/workflows/*.env

# Editor/project settings that may contain creds
.vscode/settings.json
.idea/**/workspace.xml
